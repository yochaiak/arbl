# Run make configure to generate actual local credentials.
ABRL_OPERATOR_TOKEN=
ABRL_DB_PASSWORD=
ABRL_DATABASE_URL=
ABRL_REDIS_PASSWORD=
ABRL_REDIS_URL=
ABRL_CLICKHOUSE_URL=http://127.0.0.1:58123/
ABRL_CLICKHOUSE_PASSWORD=
ABRL_ARTIFACT_URL=http://127.0.0.1:59000
ABRL_ARTIFACT_PASSWORD=
ABRL_WEB_ORIGIN=http://localhost:8430
# Optional Decodo US Residential inventory credentials.
# ABRL_SECRET_DECODO_USERNAME=
# ABRL_SECRET_DECODO_PASSWORD=
# Optional AdScore verification for site observations.
ABRL_VERIFIER_TOKEN=
ABRL_ADSCORE_ZONE_ID=
ABRL_ADSCORE_RESPONSE_KEY=
ABRL_ADSCORE_ALGORITHM=v5_0101M
# Optional local workflow budgets for expanded steps and executed steps per attempt.
# ABRL_MAX_WORKFLOW_STEPS=500
# ABRL_MAX_WORKFLOW_EXECUTED_STEPS=5000

# Optional local MaxMind databases for Decodo pre-flight.
ABRL_GEOIP_CITY_DB=
ABRL_GEOIP_ASN_DB=
ABRL_GEOIP_ANONYMOUS_DB=
# Shared provider accounts across inventory entries. Values are credential reference names.
# ABRL_PROXY_ACCOUNT_GROUPS='{"us-residential":{"provider":"decodo","username_refs":["DECODO_USERNAME"],"max_sessions":2}}'
# Set to the owned HTTPS diagnostic origin or its /lab/diagnostics URL for live smoke.
# Example placeholder (rejected in live mode): https://diagnostics.example.com
ABRL_DIAGNOSTIC_URL=
# Optional STUN endpoint on the same owned diagnostic host.
ABRL_DIAGNOSTIC_STUN_URL=
# Comma-separated forwarding headers observed in a direct control request through the same owned HTTPS tunnel.
# ABRL_DIAGNOSTIC_EDGE_HEADERS=x-forwarded-for
