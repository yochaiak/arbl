# Copy outside repository, chmod 600, fill all values; cloud-secrets.py installs via stdin.
ABRL_DEPLOYMENT=cloud
ABRL_ENVIRONMENT=cloud
ABRL_DATABASE_URL=postgresql+psycopg://abrl:CHANGE@abrl-postgres-rw:5432/abrl?sslmode=require
ABRL_SCALER_DATABASE_URL=postgresql://abrl_scaler:CHANGE@abrl-postgres-rw:5432/abrl?sslmode=require
ABRL_POSTGRES_PASSWORD=CHANGE
ABRL_SCALER_PASSWORD=CHANGE
ABRL_REDIS_PASSWORD=CHANGE
ABRL_CLICKHOUSE_URL=http://abrl-clickhouse:8123
ABRL_CLICKHOUSE_PASSWORD=CHANGE
ABRL_REDIS_SENTINELS=abrl-redis-0.abrl-redis:26379,abrl-redis-1.abrl-redis:26379,abrl-redis-2.abrl-redis:26379
ABRL_REDIS_MASTER=abrl-master
ABRL_OIDC_ISSUER=https://IDENTITY_PROVIDER
ABRL_OIDC_CLIENT_ID=CHANGE
ABRL_OIDC_CLIENT_SECRET=CHANGE
# Register https://YOUR_DOMAIN/auth/callback with your OIDC provider.
ABRL_WEB_ORIGIN=https://YOUR_DOMAIN
ABRL_SESSION_SECRET=CHANGE_TO_32_PLUS_RANDOM_CHARACTERS
ABRL_OIDC_OWNER_SUBJECT=https://IDENTITY_PROVIDER|OWNER_SUBJECT
ABRL_METRICS_TOKEN=CHANGE
ABRL_PROFILE_STORE_URL=https://fsn1.your-objectstorage.com
ABRL_PROFILE_BUCKET=abrl-profiles
ABRL_PROFILE_ENCRYPTION_KEY=CHANGE_TO_FERNET_KEY
ABRL_S3_ACCESS_KEY=CHANGE
ABRL_S3_SECRET_KEY=CHANGE
ABRL_ARTIFACT_URL=https://fsn1.your-objectstorage.com
ABRL_ARTIFACT_PASSWORD=CHANGE
ABRL_GLOBAL_CONCURRENCY=500
HCLOUD_TOKEN=CHANGE
HCLOUD_NETWORK=CHANGE_TO_TERRAFORM_OUTPUT
# Barman Cloud >=0.16 supports Hetzner SSE-C for base backups and WAL.
# Use a separate 32-byte base64 key and keep an offline recovery copy.
ABRL_BACKUP_ACCESS_KEY=CHANGE
ABRL_BACKUP_SECRET_KEY=CHANGE
ABRL_BACKUP_SSE_KEY=CHANGE_TO_32_BYTE_BASE64

# Optional instrumented AdScore verification sidecar (browser-only needs none).
# ABRL_VERIFIER_URL=http://127.0.0.1:8001
# ABRL_VERIFIER_TOKEN=<32+ random characters>
# ABRL_ADSCORE_ZONE_ID=<real zone ID>
# ABRL_ADSCORE_ZONE_KEY=<site integration key>
# ABRL_ADSCORE_RESPONSE_KEY=<server-only base64 response key>
# ABRL_ADSCORE_ALGORITHM=v5_0101M

# Optional licensed vendor credentials; installed only in abrl-browser-vendors.
# CLOAKBROWSER_LICENSE_KEY=<vendor key>
# KAMELEO_PAT=<personal access token>

# Public HTTPS origin of the ABRL-owned controlled fixture, identical on API and runners.
ABRL_CONTROLLED_ORIGIN=https://abrl.example.com

# Optional current price inputs; null remains unknown. These are estimates, not invoices.
# ABRL_FLEET_PRICES_JSON={"currency":"EUR","node_hourly":{"standard":null,"vendor":null},"fixed_hourly":null}
