{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "maximumSessions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "cloudWorkers": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "standardMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "vendorMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        }
      }
    },
    "autoscaler": {
      "type": "object",
      "properties": {
        "standard": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 2
            },
            "max": {
              "type": "integer",
              "minimum": 2,
              "maximum": 80
            }
          }
        },
        "vendor": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "webImage": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
